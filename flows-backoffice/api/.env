# --- Server ---
PORT=3000
NODE_ENV=development

# --- Sessione (STESSO secret dell’app principale per SSO tra sottodomini) ---
SESSION_SECRET=pamelaandersoninbaywatch

# --- PostgreSQL (DB condiviso) ---
# Scegli l'host corretto: 127.0.0.1 se Postgres è locale; host.docker.internal se in container su Win/Mac;
# oppure l'IP della macchina/VM. Qui metto l'IP che usavi spesso.
PGHOST=172.19.16.1
PGPORT=5432
PGUSER=postgres              # se hai creato un ruolo dedicato: flows_app
PGPASSWORD=FPW          # metti la password reale del ruolo
PGDATABASE=Flows-shared            # oppure flows_shared (nome del DB condiviso)
PGSSL=false

# --- URL usato nelle email di approvazione per il link al login FE ---
LOGIN_URL=http://localhost:5173/login

# --- SMTP / Mail (mantengo i tuoi valori) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587                # Gmail STARTTLS → secure=false
SMTP_USER=flowsbackoffice00@gmail.com
SMTP_PASS=xqyjbugirbuqurgz
MAIL_FROM="Flows Backoffice <flowsbackoffice00@gmail.com>"

# In dev puoi forzare il destinatario (utile per non inviare davvero a terzi)
MAIL_TO_OVERRIDE=
